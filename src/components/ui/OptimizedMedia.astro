---
/**
 * OptimizedMedia — Wrapper de astro:assets (<Picture /> AVIF + WebP) sin romper retículas CSS
 */
import { Picture } from 'astro:assets';
import { resolveLocalImage } from '@/lib/images';

interface Props {
  src: string;
  alt: string;
  id?: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
}

const {
  src,
  alt,
  id,
  class: className,
  widths = [640, 1100, 1600],
  sizes = '100vw',
  priority = false,
} = Astro.props;

const localImage = resolveLocalImage(src);

const safeWidths = localImage
  ? (() => {
      const cap = Math.min(localImage.width, Math.max(...widths));
      return [...new Set([...widths.filter((w) => w < cap), cap])].sort((a, b) => a - b);
    })()
  : widths;
---

{localImage ? (
  <Picture
    src={localImage}
    alt={alt}
    id={id}
    class={className}
    formats={['avif', 'webp']}
    widths={safeWidths}
    sizes={sizes}
    quality={82}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
    pictureAttributes={{ style: 'display: contents;' }}
  />
) : (
  <img
    src={src}
    alt={alt}
    id={id}
    class={className}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
  />
)}

