---
/**
 * CodeBlock Component Universal (Astro UI)
 * Caja oscura minimalista y ultraligera para fragmentos de código (HTML, CSS, JS, etc.)
 * con botón nativo de copiar al portapapeles sin dependencias externas.
 */
interface Props {
  lang?: string;
  code?: string;
  class?: string;
}

const { 
  lang = 'HTML', 
  code = '',
  class: className = '' 
} = Astro.props;
---

<div class={`code-block-box ${className}`}>
  <div class="code-block-topbar">
    <span class="code-block-lang">{lang}</span>
    <button class="code-copy-btn" type="button" aria-label="Copiar código al portapapeles">
      <span class="copy-text">Copiar</span>
    </button>
  </div>
  <pre><code>{code ? code : <slot />}</code></pre>
</div>

<script>
  // Delegación de eventos para todos los botones de copiado de bloques de código
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest('.code-copy-btn') as HTMLButtonElement | null;
    if (!btn) return;

    const block = btn.closest('.code-block-box');
    const codeEl = block?.querySelector('code');
    if (!codeEl) return;

    try {
      await navigator.clipboard.writeText(codeEl.innerText);
      const textSpan = btn.querySelector('.copy-text');
      if (textSpan) textSpan.textContent = '¡Copiado!';
      btn.classList.add('copied');

      setTimeout(() => {
        if (textSpan) textSpan.textContent = 'Copiar';
        btn.classList.remove('copied');
      }, 2000);
    } catch (err) {
      console.error('Error al copiar código:', err);
    }
  });
</script>

<style>
  .code-block-box {
    position: relative;
    margin: 2rem 0;
    border-radius: 0;
    background-color: #121214;
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .code-block-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background-color: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .code-block-lang {
    font-family: var(--font-display, sans-serif);
    font-size: 0.75rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .code-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-body, sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-xs, 4px);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    user-select: none;
  }

  .code-copy-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .code-copy-btn.copied {
    background: rgba(34, 197, 94, 0.2);
    border-color: rgba(34, 197, 94, 0.4);
    color: #4ADE80;
  }

  pre {
    margin: 0;
    padding: 1.5rem 1.5rem;
    background: transparent;
    border: none;
    overflow-x: auto;
    font-family: 'SFMono-Regular', Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
    font-size: 0.88rem;
    line-height: 1.65;
    color: #E2E2E8;
  }

  code {
    font-family: inherit;
    white-space: pre;
  }
</style>
