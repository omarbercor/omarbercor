---

<section class="triptych-section" id="about">
  <div class="triptych-grid">
    <div class="triptych-left" id="triptych-col-left">
      <div class="triptych-stat-wrap">
        <span class="triptych-stat-number">+15</span>
        <span class="triptych-stat-label">AÑOS DE TRAYECTORIA</span>
